# --- Core ---
APP_NAME=JobMatch AI
APP_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://jobmatch:jobmatch@localhost:5432/jobmatch
DATABASE_URL_SYNC=postgresql+psycopg2://jobmatch:jobmatch@localhost:5432/jobmatch

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379/0

# --- LLM Provider (pluggable: groq | runpod) ---
# runpod expects an Ollama server (https://ollama.com) reachable at
# RUNPOD_ENDPOINT, e.g. a RunPod GPU pod's proxy URL ending in :11434 exposed
# through proxy.runpod.net. RUNPOD_MODEL must be a model already pulled on
# that server (check with `GET {endpoint}/api/tags`).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
RUNPOD_API_KEY=
RUNPOD_ENDPOINT=
RUNPOD_MODEL=qwen2.5:14b

# --- Embedding Provider (pluggable: local | groq) ---
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Vector Store (pluggable: pgvector | qdrant) ---
VECTOR_STORE=pgvector
QDRANT_URL=

# --- Job Sources (pluggable adapters; leave blank to run with the seed adapter only) ---
# Available adapter keys: seed (placeholder local data), adzuna, jsearch, theirstack.
# jsearch (RapidAPI) note: watch your plan's request quota -- each ingestion
# cycle costs 1 request per entry in JSEARCH_QUERIES; raise
# INGESTION_INTERVAL_MINUTES if you're on a limited free tier.
JOB_SOURCES_ENABLED=seed
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_RAPIDAPI_KEY=
# City-specific queries measurably improve location-field fidelity in
# JSearch's response versus a generic country-wide query -- worth the extra
# thought since accurate city data feeds directly into location matching.
JSEARCH_QUERIES=backend developer jobs in bangalore,software developer jobs in chennai
JSEARCH_COUNTRY=in
JSEARCH_NUM_PAGES=1
# theirstack note: billed 1 credit PER JOB RETURNED against a per-account
# MONTHLY pool, not a request quota -- do not add it to JOB_SOURCES_ENABLED
# alongside a short INGESTION_INTERVAL_MINUTES, the scheduler runs every
# enabled source on the same cadence. Run it as an occasional/manual pass.
THEIRSTACK_API_KEY=
THEIRSTACK_QUERIES=Backend Developer,Python Developer,Software Engineer
THEIRSTACK_COUNTRY=IN
THEIRSTACK_MAX_AGE_DAYS=3
THEIRSTACK_LIMIT_PER_QUERY=10

# --- File Storage ---
RESUME_STORAGE_DIR=./storage/resumes
MAX_RESUME_SIZE_MB=10

# --- Matching weights (must sum to 1.0) ---
WEIGHT_SKILLS=0.25
WEIGHT_EXPERIENCE=0.20
WEIGHT_ROLE=0.15
WEIGHT_SEMANTIC=0.15
WEIGHT_LOCATION=0.10
WEIGHT_DOMAIN=0.05
WEIGHT_EDUCATION=0.03
WEIGHT_WORK_MODE=0.03
WEIGHT_RECENCY=0.02
WEIGHT_TRUST=0.02

DUPLICATE_THRESHOLD=0.85
FRESH_JOB_WINDOW_DAYS=3

# --- Ingestion scheduling: once real source keys (e.g. ADZUNA_*) are set,
# this makes fresh listings flow in automatically without any manual step ---
INGESTION_SCHEDULER_ENABLED=true
INGESTION_INTERVAL_MINUTES=30
